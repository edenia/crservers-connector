# Copy to .env (never committed). Keys: 32 random bytes, base64url:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://postgres:devonly@127.0.0.1:54329/connector
CLIENT_AREA_URL=https://clients.example.test
CLIENT_AREA_API_ID=
CLIENT_AREA_API_KEY=
# Must equal the key configured in the client-area extension.
REQ_KEY=
ENCRYPTION_KEY=
# Comma-separated extra exact redirect URIs (e.g. MCP Inspector in dev).
EXTRA_REDIRECT_URIS=
