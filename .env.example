# Copy to .env (never committed). Keys: 32 random bytes, base64url:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://postgres:devonly@127.0.0.1:54329/connector
HOSTBILL_URL=https://hostbill.crservers.net
HOSTBILL_API_ID=
HOSTBILL_API_KEY=
# Must equal the HostBill plugin's ReqKeyCurrent.
REQ_KEY=
ENCRYPTION_KEY=
# Comma-separated extra exact redirect URIs (e.g. MCP Inspector in dev).
EXTRA_REDIRECT_URIS=
